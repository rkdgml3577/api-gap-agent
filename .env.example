LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
MAX_STEPS=24
# Approval gate before a run is reported complete: auto (default, no pause) or human (wait for approval in the UI). Swappable for an LLM judge later.
APPROVAL_MODE=human
APPROVAL_TIMEOUT=600
# In human mode, pause for approval only when a finding matches these triggers; otherwise auto-approve. Comma list of: violates,uncertain
APPROVAL_TRIGGERS=violates,uncertain
